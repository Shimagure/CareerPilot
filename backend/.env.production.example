# CareerPilot API — Production Environment Template (P5.1)
# =========================================================
# SAFE EXAMPLE — contains NO real secrets. Every secret-bearing value below is
# a clearly marked placeholder that an operator MUST replace before running.
#
# How to deploy:
#   1. Copy this file to your deployment host as `.env` (inside `backend/`).
#   2. Replace every `REPLACE_...` value per the notes below.
#   3. Set restricted file permissions on `.env` (e.g. `chmod 600`).
#   4. Start the API as a single uvicorn worker — see deploy/README.md.
#
# Do NOT put real credentials in any committed file, including this one.

# =============================================================================
# ENVIRONMENT (REQUIRED)
# =============================================================================
# "production" enables: strict startup validation, security headers, and it
# DISABLES /docs, /redoc and /openapi.json. Never ship with "development".
ENVIRONMENT=production

# =============================================================================
# SECURITY / JWT (REQUIRED — placeholder, replace it)
# =============================================================================
# Generate a real secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rules: at least 32 characters, NOT the MANDATORY default below, never reused.
#   - validate_production_config() REFUSES to start with the default value.
#   - A fake-looking literal (e.g. "changeme" or "abc123...") is NOT a secret.
SECRET_KEY=REPLACE_WITH_TOKENS_ALLOWED_GENERATED_SECRET_URLSAFE_32PLUS

# JWT algorithm (HS256 is the only supported value)
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS (REQUIRED — explicit origins only, never "*")
# =============================================================================
# The recommended P5.1 topology is same-origin (frontend and API behind ONE
# reverse proxy), in which case CORS is effectively moot — but the value must
# still be explicit and non-wildcard to satisfy production validation.
# Set it to the exact public origin the demo is served from:
#   CORS_ALLOWED_ORIGINS=https://careerpilot.example.com
# Space-separate multiple origins if you ever deploy more than one origin:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Wildcard "*" is REJECTED in production.
CORS_ALLOWED_ORIGINS=REPLACE_WITH_YOUR_PUBLIC_ORIGIN_ONLY

# =============================================================================
# DATABASE (REQUIRED — absolute path or PostgreSQL; relative is rejected)
# =============================================================================
# The current app is a single monolith: the PUBLIC demo endpoints never touch
# the database, but the shared production startup still requires a valid,
# absolute DATABASE_URL. For a demo-only deployment point this at a real,
# provisioned SQLite path (writable) or PostgreSQL URL.
#   SQLite (absolute path — note the four slashes):
#     DATABASE_URL=sqlite+aiosqlite:////var/lib/careerpilot/careerpilot.db
#   PostgreSQL:
#     DATABASE_URL=postgresql+asyncpg://user:password@host:5432/careerpilot
DATABASE_URL=REPLACE_sqlite+aiosqlite:////absolute/path/to/careerpilot.db

# Enable SQLAlchemy query logging (debug only — keep false in production)
DATABASE_ECHO=false

# =============================================================================
# RATE LIMITING (MUST stay enabled in production; RATE_LIMIT_TRUST_PROXY is
# the only deployment-dependent flag here)
# =============================================================================
# The in-process limiter is per-process, so production MUST run exactly ONE
# uvicorn worker. Disabling it is rejected by production validation.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_CLIENTS=10000

# IMPORTANT (P5.1): enable ONLY when the app is reachable exclusively through
# the single reverse proxy defined in deploy/nginx.conf — that proxy sets
# X-Forwarded-For and clients can never contact uvicorn directly. Leave false
# otherwise: with it false, public/auth rate limits key on the proxy's address
# (still limited, just shared), which is safe but coarser.
RATE_LIMIT_TRUST_PROXY=true

# Tunables (defaults are sane for a demo deployment; adjust only with reason)
PUBLIC_READ_LIMIT_PER_IP=120
PUBLIC_READ_WINDOW_SECONDS=60
LOGIN_LIMIT_PER_IP=20
LOGIN_WINDOW_SECONDS=300
LOGIN_LIMIT_PER_ACCOUNT=10
LOGIN_ACCOUNT_WINDOW_SECONDS=900
REGISTER_LIMIT_PER_IP=10
REGISTER_WINDOW_SECONDS=3600
SEARCH_START_LIMIT_PER_USER=6
SEARCH_START_WINDOW_SECONDS=300
SEARCH_RUN_MAX_DURATION_SECONDS=1200
DOCGEN_LIMIT_PER_USER=10
DOCGEN_WINDOW_SECONDS=3600
DOCGEN_MAX_CONCURRENT_PER_USER=1
DOCGEN_CONCURRENCY_RETRY_AFTER_SECONDS=10

# =============================================================================
# RESUME UPLOADS (optional override; keep outside the web root)
# =============================================================================
# UPLOAD_DIR=/var/lib/careerpilot/uploads
MAX_RESUME_SIZE_MB=10

# =============================================================================
# LLM PROVIDER (optional — only needed if private search/assistant features
# are used; the public demo does not invoke the LLM)
# =============================================================================
# LLM_PROVIDER=openai
# OPENAI_API_KEY=REPLACE_...              # never commit
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=REPLACE_...           # never commit
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# =============================================================================
# PRODUCTION PRE-FLIGHT CHECKLIST (verified by deploy/README.md smoke test)
# =============================================================================
# [ ] ENVIRONMENT=production
# [ ] SECRET_KEY is a freshly generated token_urlsafe(32) string
# [ ] CORS_ALLOWED_ORIGINS is the public origin(s) — NOT "*"
# [ ] DATABASE_URL is absolute SQLite or PostgreSQL — NOT relative
# [ ] RATE_LIMIT_ENABLED=true
# [ ] RATE_LIMIT_TRUST_PROXY=true ONLY behind the single nginx proxy
# [ ] One uvicorn worker (rate limiter is in-process)
# [ ] /docs and /redoc are 404 (production disables them)
# [ ] Website origin serves index.html with SPA fallback for /demo/*
# [ ] /api/* proxied to 127.0.0.1:8000; backend never exposed directly